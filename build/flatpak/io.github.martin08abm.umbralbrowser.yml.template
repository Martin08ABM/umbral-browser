app-id: io.github.martin08abm.umbralbrowser
runtime: org.freedesktop.Platform
runtime-version: '25.08'
sdk: org.freedesktop.Sdk
base: org.mozilla.firefox.BaseApp
base-version: '25.08'
command: umbral-launcher
finish-args:
  - --allow=devel
  - --share=ipc
  - --share=network
  - --socket=pulseaudio
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri
  - --filesystem=xdg-download:rw
  - --env=DICPATH=/usr/share/hunspell
  - --talk-name=org.a11y.Bus
  - --talk-name=org.gtk.vfs.*
  - --talk-name=org.freedesktop.FileManager1
  - --own-name=org.mpris.MediaPlayer2.firefox.*
modules:
  - name: umbral-browser
    buildsystem: simple
    build-commands:
      - install -d /app/umbral
      - cp -a zen/. /app/umbral/
      - install -Dm0755 metadata/umbral-launcher /app/bin/umbral-launcher
      - install -Dm0644 metadata/io.github.martin08abm.umbralbrowser.desktop /app/share/applications/io.github.martin08abm.umbralbrowser.desktop
      - install -Dm0644 metadata/io.github.martin08abm.umbralbrowser.metainfo.xml /app/share/metainfo/io.github.martin08abm.umbralbrowser.metainfo.xml
      - install -Dm0644 metadata/io.github.martin08abm.umbralbrowser.png /app/share/icons/hicolor/512x512/apps/io.github.martin08abm.umbralbrowser.png
      - install -Dm0644 metadata/LICENSE /app/share/licenses/io.github.martin08abm.umbralbrowser/LICENSE
      - install -Dm0644 metadata/CREDITS.md /app/share/doc/io.github.martin08abm.umbralbrowser/CREDITS.md
    sources:
      - type: archive
        url: "{archive_url}"
        sha256: "{archive_sha256}"
        strip-components: 0
      - type: dir
        path: metadata
        dest: metadata
