+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+const { AddonManager } = ChromeUtils.importESModule(
+  "resource://gre/modules/AddonManager.sys.mjs"
+);
+
+add_task(async function test_umbral_home_reports_only_addon_state() {
+  const addon = await AddonManager.getAddonByID("uBlock0@raymondhill.net");
+  const expected = addon ? (addon.isActive ? "active" : "disabled") : "unavailable";
+
+  await BrowserTestUtils.withNewTab("about:home", async browser => {
+    const getStatus = () =>
+      SpecialPowers.spawn(browser, [], () => {
+        const element = content.document.getElementById(
+          "umbral-home-ublock-status"
+        );
+        return element?.textContent.trim() ?? null;
+      });
+    await TestUtils.waitForCondition(
+      async () =>
+        (await getStatus()) ===
+          { active: "Active", disabled: "Disabled", unavailable: "Unavailable" }[
+            expected
+          ],
+      `Homepage reports the AddonManager state (${expected})`
+    );
+    Assert.ok(await getStatus(), "Homepage has a dedicated uBO status field");
+
+    if (!addon) {
+      return;
+    }
+
+    registerCleanupFunction(async () => {
+      if (!addon.isActive) {
+        await addon.enable();
+      }
+    });
+    await addon.disable();
+    const loaded = BrowserTestUtils.browserLoaded(browser, true, "about:home");
+    BrowserTestUtils.reloadTab(gBrowser.selectedTab);
+    await loaded;
+    await TestUtils.waitForCondition(
+      async () => (await getStatus()) === "Disabled",
+      "Disabling uBO changes the homepage status to disabled"
+    );
+    await addon.enable();
+  });
+});
