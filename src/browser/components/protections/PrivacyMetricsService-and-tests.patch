+
+  Assert.deepEqual(stats, { trackers: 0, cookies: 0 });
+});
+
+add_task(async function test_getHomepageStats_disabled_source_is_unavailable() {
+  Services.prefs.setBoolPref("browser.contentblocking.database.enabled", false);
+  try {
+    Assert.equal(await PrivacyMetricsService.getHomepageStats(), null);
+  } finally {
+    Services.prefs.setBoolPref("browser.contentblocking.database.enabled", true);
+  }
+});
+
+add_task(async function test_getHomepageStats_propagates_query_failure() {
+  const getWeeklyStats = PrivacyMetricsService.getWeeklyStats;
+  PrivacyMetricsService.getWeeklyStats = async () => {
+    throw new Error("controlled database failure");
+  };
+  try {
+    await Assert.rejects(
+      PrivacyMetricsService.getHomepageStats(),
+      /controlled database failure/
+    );
+  } finally {
+    PrivacyMetricsService.getWeeklyStats = getWeeklyStats;
+  }
+});
