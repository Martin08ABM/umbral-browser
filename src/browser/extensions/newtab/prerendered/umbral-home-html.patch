+    <link rel="stylesheet" href="resource://newtab/prerendered/umbral-home.css" />
+  </head>
+  <body>
+    <main>
+      <img
+        class="logo logo-light"
+        src="chrome://branding/content/umbral-logo-light.png"
+        data-l10n-id="umbral-home-logo"
+        alt="Umbral"
+      />
+      <img
+        class="logo logo-dark"
+        src="chrome://branding/content/umbral-logo-dark.png"
+        data-l10n-id="umbral-home-logo"
+        alt="Umbral"
+      />
+    </main>
+    <section class="cards" data-l10n-id="umbral-home-cards">
+      <article class="card">
+        <div class="card-heading">
+          <h2 id="umbral-home-trackers-etp-label" data-l10n-id="umbral-home-trackers-etp">Trackers · ETP</h2>
+          <button
+            class="tooltip-trigger"
+            id="umbral-home-trackers-info"
+            type="button"
+            data-l10n-id="umbral-home-etp-info"
+            aria-describedby="umbral-home-trackers-tooltip"
+          >
+            <span aria-hidden="true">i</span>
+          </button>
+          <span
+            class="card-tooltip"
+            id="umbral-home-trackers-tooltip"
+            role="tooltip"
+            data-l10n-id="umbral-home-etp-tooltip"
+          >
+            Counts records classified by Firefox Enhanced Tracking Protection, not ads, network requests, or uBlock Origin blocks.
+          </span>
+        </div>
+        <p class="period" id="umbral-home-trackers-period" data-l10n-id="umbral-home-period-seven-days">Last 7 days</p>
+        <p class="metric" id="umbral-home-trackers-count" aria-live="polite" data-l10n-id="umbral-home-no-data">No data</p>
+      </article>
+      <article class="card">
+        <div class="card-heading">
+          <h2 id="umbral-home-cookies-etp-label" data-l10n-id="umbral-home-cookies-etp">Tracking cookies · ETP</h2>
+          <button
+            class="tooltip-trigger"
+            id="umbral-home-cookies-info"
+            type="button"
+            data-l10n-id="umbral-home-etp-info"
+            aria-describedby="umbral-home-cookies-tooltip"
