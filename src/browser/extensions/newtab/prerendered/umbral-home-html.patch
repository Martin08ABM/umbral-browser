+<html xmlns="http://www.w3.org/1999/xhtml">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="color-scheme" content="light dark" />
+    <meta
+      http-equiv="Content-Security-Policy"
+      content="default-src 'none'; img-src chrome:; style-src resource:; script-src 'none'; object-src 'none';"
+    />
+    <title data-l10n-id="umbral-home-title">Umbral</title>
+    <link rel="localization" href="browser/umbralHome.ftl" />
+    <link rel="icon" type="image/png" sizes="32x32" href="chrome://branding/content/icon32.png" />
