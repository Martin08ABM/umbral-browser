 //   browser -> { actor, browser, browsingContext, portID, url, loaded }
 let gLoadedTabs = new Map();
 
+const UMBRAL_SHORTCUTS_PREF = "browser.newtabpage.umbral.shortcuts";
+
+function normalizeUmbralShortcuts(shortcuts) {
+  if (!Array.isArray(shortcuts) || shortcuts.length > 12) {
+    return null;
+  }
+  const normalized = [];
+  for (const shortcut of shortcuts) {
+    if (
+      !shortcut ||
+      typeof shortcut.name !== "string" ||
+      typeof shortcut.url !== "string" ||
+      shortcut.name.trim().length < 1 ||
+      shortcut.name.trim().length > 48 ||
+      shortcut.url.length > 2048
+    ) {
+      return null;
+    }
+    let url;
+    try {
+      url = new URL(shortcut.url);
+    } catch {
+      return null;
+    }
+    if (
+      !["http:", "https:"].includes(url.protocol) ||
+      url.username ||
+      url.password
+    ) {
+      return null;
+    }
+    normalized.push({ name: shortcut.name.trim(), url: url.href });
+  }
+  return normalized;
+}
