+add_task(async function private_window_events_are_not_persisted() {
+  const countBefore = await queryAllTypes();
+  const privateWin = await BrowserTestUtils.openNewBrowserWindow({
+    private: true,
+  });
+  try {
+    const tab = BrowserTestUtils.addTab(privateWin.gBrowser, TEST_TOP_PAGE);
+    const browser = privateWin.gBrowser.getBrowserForTab(tab);
+    await BrowserTestUtils.browserLoaded(browser);
+    await loadTrackerImage(
+      browser,
+      TEST_3RD_PARTY_DOMAIN_TP + TEST_PATH + "raptor.jpg?private=" + Math.random()
+    );
+
+    const log = JSON.parse(await browser.getContentBlockingLog());
+    is(Object.keys(log).length, 1, "Private tab records a blocked tracker in memory");
+    BrowserTestUtils.removeTab(tab);
+  } finally {
+    await BrowserTestUtils.closeWindow(privateWin);
+  }
+
+  is(
+    await queryAllTypes(),
+    countBefore,
+    "Private-window content-blocking events are not added to persistent ETP counts"
+  );
+  await TrackingDBService.clearAll();
+});
+
